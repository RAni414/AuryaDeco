# Fichiers internes : accès direct interdit...
Require all denied

# ... sauf les points d'entrée publics appelés par le navigateur
# (favoris, API publiques, formulaire d'avis et catégories personnalisées).
<FilesMatch "^(favoris|favorites-api|deco-api|avis|categorie)\.php$">
  Require all granted
</FilesMatch>
