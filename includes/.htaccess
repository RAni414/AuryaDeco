# Fichiers internes : accès direct interdit...
Require all denied

# ... sauf les points d'entrée publics appelés par le navigateur
# (favoris, API publiques, formulaire d'avis et catégories personnalisées).
<FilesMatch "^(favoris|favorites-api|deco-api|avis|categorie|sitemap|robots|compte)\.php$">
  Require all granted
</FilesMatch>

<IfModule mod_php.c>
 php_value upload_max_filesize 30M
 php_value post_max_size 40M
</IfModule>
<IfModule php_module>
 php_value upload_max_filesize 30M
 php_value post_max_size 40M
</IfModule>
