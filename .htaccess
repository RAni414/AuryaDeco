# AuryaDeco : réglages Apache
Options -Indexes
DirectoryIndex index.php

# Protéger la configuration
<Files "config.php">
  Require all denied
</Files>

# Forcer HTTPS : retirez les # des 3 lignes ci-dessous une fois le certificat SSL actif
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Taille maximale des photos envoyées (si votre hébergeur l'autorise)
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 40M
</IfModule>
