# Les photos uniquement : aucun script ne peut s'exécuter ici
<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
Options -Indexes

# Chaque photo reçoit un nom unique : elle peut rester en cache longtemps.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
