# AuryaDeco : variables d'environnement (EasyPanel > Environment).
# Valeurs d'exemple uniquement : ne mettez jamais de vrais secrets dans ce fichier.

# --- Base de données MySQL / MariaDB (obligatoire) ---
DB_HOST=auryadeco_db
DB_PORT=3306
DB_NAME=auryadeco
DB_USER=auryadeco
DB_PASSWORD=change-me-strong-password

# --- Premier démarrage : compte administrateur créé si la base est vide ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-at-least-8-chars
SHOP_NAME=AuryaDeco
# 1 = ajoute les produits d'exemple à la première installation
SEED_DEMO_PRODUCTS=0

# --- Assistant déco IA (optionnel : sans clé, l'assistant reste en mode démo) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Divers (optionnel) ---
PORT=8080
APP_TIMEZONE=Africa/Tunis
APP_DEBUG=0
BASE_URL=
DB_WAIT_SECONDS=60
